{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Dev Server (Port 3000)",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend: Typecheck (tsc --noEmit)",
      "type": "shell",
      "command": "npm run lint",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Frontend: Production Build",
      "type": "shell",
      "command": "npm run build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Desktop: Tauri 2 Dev (requires Tauri setup)",
      "type": "shell",
      "command": "npx tauri dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
